# Kubernetes Secrets Template
# FIX: CONFIG-002 - Externalize K8s secrets properly
#
# INSTRUCTIONS:
# 1. Copy this file to secrets.yaml
# 2. Replace all <PLACEHOLDER> values with actual base64-encoded secrets
# 3. NEVER commit secrets.yaml to version control
# 4. Add secrets.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: echoverse-secrets
  namespace: default
type: Opaque
data:
  # Database (base64 encoded)
  DATABASE_URL: <BASE64_ENCODED_DB_URL>
  
  # Security (base64 encoded)
  SESSION_SECRET: <BASE64_ENCODED_SESSION_SECRET>
  JWT_SECRET: <BASE64_ENCODED_JWT_SECRET>
  ENCRYPTION_KEY: <BASE64_ENCODED_ENCRYPTION_KEY>
  
  # Stripe (base64 encoded)
  STRIPE_SECRET_KEY: <BASE64_ENCODED_STRIPE_KEY>
  STRIPE_WEBHOOK_SECRET: <BASE64_ENCODED_WEBHOOK_SECRET>
  
  # Email (base64 encoded)
  SENDGRID_API_KEY: <BASE64_ENCODED_SENDGRID_KEY>
  
  # Monitoring (base64 encoded)
  SENTRY_DSN: <BASE64_ENCODED_SENTRY_DSN>
  
  # Storage (base64 encoded)
  AWS_S3_ACCESS_KEY_ID: <BASE64_ENCODED_AWS_KEY>
  AWS_S3_SECRET_ACCESS_KEY: <BASE64_ENCODED_AWS_SECRET>
  
  # Redis (base64 encoded)
  REDIS_URL: <BASE64_ENCODED_REDIS_URL>
  
  # AI (base64 encoded)
  OPENAI_API_KEY: <BASE64_ENCODED_OPENAI_KEY>

---
# ConfigMap for non-sensitive configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: echoverse-config
  namespace: default
data:
  NODE_ENV: "production"
  PORT: "5000"
  LOG_LEVEL: "info"
  ALLOWED_ORIGINS: "https://yourapp.com"
  
  # Feature Flags
  ENABLE_AI_FEATURES: "true"
  ENABLE_WEBSOCKETS: "true"
  ENABLE_PUSH_NOTIFICATIONS: "false"
  
  # Rate Limiting
  RATE_LIMIT_WINDOW_MS: "900000"
  RATE_LIMIT_MAX_REQUESTS: "100"

---
# How to encode secrets:
# echo -n 'your-secret-value' | base64
#
# How to apply:
# kubectl apply -f k8s/secrets.yaml
#
# How to verify:
# kubectl get secrets echoverse-secrets
# kubectl describe secret echoverse-secrets
#
# How to use in deployment:
# See deployment.yaml for envFrom reference
