# Multi-stage production build with optimizations

# Stage 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app

# Install security updates
RUN apk upgrade --no-cache

# Copy package files
COPY package*.json ./

# Install production dependencies with cache mounting
RUN --mount=type=cache,target=/root/.npm \
    npm ci --only=production --no-audit && \
    npm cache clean --force

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app

# Install build dependencies
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit

# Copy source files
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY tailwind.config.ts ./
COPY postcss.config.js ./
COPY drizzle.config.ts ./
COPY server ./server
COPY client ./client
COPY shared ./shared

# Build application
ENV NODE_ENV=production
RUN npm run build

# Stage 3: Scanner
FROM aquasec/trivy:latest AS scanner
COPY --from=builder /app /scan
RUN trivy filesystem --exit-code 0 --no-progress /scan

# Stage 4: Final production image
FROM node:20-alpine AS runner
WORKDIR /app

# Install dumb-init and security tools
RUN apk add --no-cache dumb-init tini curl && \
    apk upgrade --no-cache

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 echoverse && \
    addgroup echoverse nodejs

# Set up directories with proper permissions
RUN mkdir -p uploads logs backups && \
    chown -R echoverse:nodejs uploads logs backups

# Copy production dependencies
COPY --from=deps --chown=echoverse:nodejs /app/node_modules ./node_modules

# Copy built application
COPY --from=builder --chown=echoverse:nodejs /app/dist ./dist
COPY --from=builder --chown=echoverse:nodejs /app/package*.json ./

# Set security labels
LABEL org.opencontainers.image.title="EchoVerse Platform" \
      org.opencontainers.image.description="Production-ready full-stack platform" \
      org.opencontainers.image.vendor="EchoVerse" \
      org.opencontainers.image.security.contact="security@echoverse.com"

# Set environment
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=2048" \
    NPM_CONFIG_LOGLEVEL=warn

# Drop to non-root user
USER echoverse

# Expose port
EXPOSE 5000

# Health check with retry
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start application
CMD ["node", "dist/index.js"]
