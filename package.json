{
  "name": "rest-express",
  "version": "3.0.0",
  "description": "Production-ready full-stack TypeScript application powered by Express, Vite 7+, and Capacitor 7+, deployable to Web, iOS & Android.",
  "license": "MIT",
  "type": "module",
  "author": "Your Team <dev@yourdomain.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/rest-express.git"
  },
  "homepage": "https://yourdomain.com",
  "bugs": {
    "url": "https://github.com/your-org/rest-express/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",

  "scripts": {
    "dev": "vite dev",
    "dev:api": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && tsc --noEmit false",
    "build:cdn": "npm run build && tsx scripts/cdn-upload.ts",
    "build:verify": "npm run build && node scripts/verify-build.js",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/index.js",
    "clean": "rimraf dist .vite .cache .turbo",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "migrate:status": "tsx scripts/migrate.ts status",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:create": "tsx scripts/migrate.ts create",
    "migrate:auto": "tsx scripts/migrate-non-interactive.ts",
    "seed": "tsx server/seed-enhanced.ts",
    "ssl:generate": "tsx scripts/ssl-automation.ts generate",
    "ssl:renew": "tsx scripts/ssl-automation.ts renew",
    "ssl:validate": "tsx scripts/ssl-automation.ts validate",
    "ssl:auto-renew": "tsx scripts/ssl-automation.ts auto-renew",
    "ssl:check-expiry": "tsx scripts/ssl-automation.ts check-expiry",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prod:check": "tsx scripts/production-readiness.ts",
    "deploy": "./scripts/deploy-production.sh",
    "prod:deploy": "npm run build:verify && npm run prod:check && npm run deploy",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "env:validate": "tsx scripts/validate-env.ts",
    "bundle:analyze": "vite build --analyze",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "smoke:test": "tsx scripts/smoke-tests.ts",
    "cleanup:prod": "tsx scripts/cleanup-production.ts",
    "ios:build": "./scripts/build-ios.sh",
    "android:build": "./scripts/build-android.sh",
    "mobile:sync": "npx cap sync",
    "mobile:open": "npx cap open",
    "ci:check": "npm run typecheck && npm run lint && npm run test",
    "ci:build": "npm run clean && npm run build",
    "prod:ready": "npm run cleanup:prod && npm run bundle:budget && npm run typecheck && echo '✅ Production Ready!'"
  },

  "dependencies": {
    "@capacitor/android": "^7.5.0",
    "@capacitor/app": "^7.2.0",
    "@capacitor/browser": "^7.2.0",
    "@capacitor/camera": "^7.2.0",
    "@capacitor/core": "^7.5.0",
    "@capacitor/device": "^7.2.0",
    "@capacitor/haptics": "^7.2.0",
    "@capacitor/ios": "^7.5.0",
    "@capacitor/keyboard": "^7.2.0",
    "@capacitor/network": "^7.2.0",
    "@capacitor/preferences": "^7.2.0",
    "@capacitor/push-notifications": "^7.2.0",
    "@capacitor/share": "^7.2.0",
    "@capacitor/splash-screen": "^7.2.0",
    "@capacitor/status-bar": "^7.2.0",
    "@aws-sdk/client-cloudfront": "^3.935.0",
    "@aws-sdk/client-s3": "^3.935.0",
    "@aws-sdk/client-ses": "^3.935.0",
    "@fastify/swagger": "^10.0.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.10.6",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@opentelemetry/semantic-conventions": "^1.37.1",
    "@playwright/test": "^1.58.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.8",
    "@stripe/react-stripe-js": "^5.0.0",
    "@stripe/stripe-js": "^8.0.0",
    "@tanstack/react-query": "^5.61.0",
    "bcrypt": "^6.1.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^3.7.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.8.0",
    "express": "^4.22.0",
    "express-rate-limit": "^8.2.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.1.0",
    "lucide-react": "^0.460.0",
    "multer": "^2.0.2",
    "openai": "^5.25.0",
    "pdfkit": "^0.17.4",
    "prom-client": "^15.2.0",
    "qrcode": "^1.6.0",
    "react": "^18.3.2",
    "react-dom": "^18.3.2",
    "react-hook-form": "^7.58.0",
    "redis": "^5.9.0",
    "sharp": "^0.34.5",
    "stripe": "^18.8.0",
    "supertest": "^7.1.6",
    "tailwind-merge": "^2.7.0",
    "tailwindcss-animate": "^1.1.0",
    "validator": "^13.16.0",
    "vitest": "^3.3.0",
    "wouter": "^3.4.0",
    "ws": "^8.18.4",
    "zod": "^3.25.0",
    "zxcvbn": "^4.5.0"
  },

  "devDependencies": {
    "@types/express": "^4.17.22",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.3.0",
    "@vitest/ui": "^3.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.33.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.3",
    "eslint-plugin-react": "^7.38.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "postcss": "^8.4.48",
    "prettier": "^3.7.0",
    "tailwindcss": "^3.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.0",
    "vitest": "^3.3.0",
    "playwright": "^1.58.0"
  },

  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "ioredis": "^5.9.0"
  },

  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/your-org"
  }
}
