#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# ISSUE #121 FIX: Git hooks for code quality

echo "🔍 Running pre-commit checks..."

# Run linter
echo "📝 Checking code style..."
npm run lint || {
  echo "❌ Linting failed. Please fix errors before committing."
  exit 1
}

# Run type checking
echo "🔍 Type checking..."
npm run typecheck || {
  echo "❌ Type checking failed. Please fix type errors before committing."
  exit 1
}

# Run tests
echo "🧪 Running tests..."
npm test -- --run || {
  echo "❌ Tests failed. Please fix failing tests before committing."
  exit 1
}

# Check for console.log statements in production code
echo "🔍 Checking for console statements..."
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n "console\.\(log\|debug\)" 2>/dev/null; then
  echo "⚠️  Warning: Found console.log/console.debug statements."
  echo "   Consider removing them or using a proper logger."
  # Don't fail, just warn
fi

# Check for TODO/FIXME comments
echo "🔍 Checking for TODO/FIXME comments..."
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n "TODO\|FIXME" 2>/dev/null; then
  echo "ℹ️  Info: Found TODO/FIXME comments. Consider addressing them."
  # Don't fail, just inform
fi

echo "✅ Pre-commit checks passed!"
