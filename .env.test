# Test Environment Configuration
NODE_ENV=test

# Database
DATABASE_URL_TEST=${DATABASE_URL}

# Session and Security Secrets (Test)
SESSION_SECRET=test-session-secret-key-for-development-only-do-not-use-in-production-minimum-32-characters
JWT_SECRET=test-jwt-secret-key-for-development-only-do-not-use-in-production-minimum-32-characters
FILE_ENCRYPTION_KEY=test-file-encryption-key-for-development-only-do-not-use-in-production-32
TWO_FACTOR_BACKUP_ENCRYPTION_KEY=test-2fa-backup-key-for-development-only-do-not-use-in-production-32
WEBHOOK_SIGNATURE_SECRET=test-webhook-signature-key-for-development-only-do-not-use-in-production

# Disable external services in tests
ENABLE_EMAIL_SERVICE=false
ENABLE_SMS_SERVICE=false
ENABLE_PUSH_NOTIFICATIONS=false

# Test-specific settings
LOG_LEVEL=error
RATE_LIMIT_ENABLED=false
